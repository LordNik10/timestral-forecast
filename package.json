{
  "name": "timestral-forecast",
  "private": true,
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "setup": "npm install && node scripts/uv.mjs sync --directory backend",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint typecheck",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test lint typecheck build",
    "test:fast": "turbo run test:fast",
    "samples": "cd backend && node ../scripts/uv.mjs run python ../samples/genera_campioni.py"
  },
  "devDependencies": {
    "turbo": "2.11.10"
  }
}
